server {
    listen 8080 default_server;
    server_name _;
    location = /health { access_log off; return 200 'ok'; }
    location / { return 444; }
}

server {
    listen 8080;
    server_name ${ADMIN_ALLOWED_HOSTS};
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 ipv6=off valid=10s;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location = /health { access_log off; return 200 'ok'; }
    location = /api/admin { return 404; }
    # This is the only administrative mutation exposed by the LAN proxy.
    location ~ "^/api/admin/users/[0-9a-fA-F-]{36}/laboratory$" {
        if ($request_method != PATCH) { return 405; }
        set $admin_upstream admin-api:8000;
        proxy_pass http://$admin_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_cache off;
    }
    location /api/admin/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        set $admin_upstream admin-api:8000;
        proxy_pass http://$admin_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_cache off;
    }
    location /api/ { return 404; }
    location ~* \.map$ { return 404; }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location / { try_files $uri $uri/ /index.html; }
}
