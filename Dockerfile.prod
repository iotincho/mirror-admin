FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && npm run verify:build

FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf \
    && chown nginx:nginx /etc/nginx/conf.d
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY docker/15-validate-admin-hosts.sh /docker-entrypoint.d/15-validate-admin-hosts.sh
RUN chmod 755 /docker-entrypoint.d/15-validate-admin-hosts.sh
COPY --from=build /app/dist /usr/share/nginx/html
ENV NGINX_ENVSUBST_FILTER=^ADMIN_ALLOWED_HOSTS$
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1:8080/health || exit 1
CMD ["nginx", "-g", "daemon off;"]
