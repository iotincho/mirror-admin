    "react": "^19.2.0",
    "react-admin": "^5.15.4",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1",
    "zod": "^4.0.0",
    "ra-language-english": "^5.15.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.0.0",
    "typescript": "~6.0.2",
